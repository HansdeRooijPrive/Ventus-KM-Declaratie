# De Python-build (build.py) voegt src/ samen tot index.html. Forceer LF voor
# deze bestanden zodat de build op Windows én Linux (GitHub Actions) exact
# hetzelfde resultaat geeft, ongeacht core.autocrlf.
index.html text eol=lf
build.py    text eol=lf
src/**      text eol=lf
app.json    text eol=lf

# Iconen zijn binair: nooit regeleindes vertalen (src/** hierboven zou ze beschadigen).
src/icons/*.png binary
